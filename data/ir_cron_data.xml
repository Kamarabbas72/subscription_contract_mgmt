<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron 1: Check for contracts approaching renewal (daily at 08:00) -->
    <record id="ir_cron_check_renewals" model="ir.cron">
        <field name="name">Subscription: Check Approaching Renewals</field>
        <field name="model_id" ref="model_subscription_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_renewals()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
    </record>

    <!-- Cron 2: Suspend overdue contracts (daily at 09:00) -->
    <record id="ir_cron_suspend_overdue" model="ir.cron">
        <field name="name">Subscription: Suspend Overdue Contracts</field>
        <field name="model_id" ref="model_subscription_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_suspend_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">6</field>
    </record>

    <!-- Cron 3: Generate recurring invoices (daily at 07:00) -->
    <record id="ir_cron_generate_invoices" model="ir.cron">
        <field name="name">Subscription: Generate Recurring Invoices</field>
        <field name="model_id" ref="model_subscription_contract"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">4</field>
    </record>
</odoo>
