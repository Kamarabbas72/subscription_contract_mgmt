<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Security Groups
    ============================================================ -->
    <record id="group_subscription_user" model="res.groups">
        <field name="name">Subscription User</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_subscription_manager" model="res.groups">
        <field name="name">Subscription Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]"/>
    </record>

    <!-- ============================================================
         Record Rules — Internal Users
    ============================================================ -->

    <!-- Subscription Users see contracts assigned to them or their company -->
    <record id="subscription_contract_user_rule" model="ir.rule">
        <field name="name">Subscription Contract: User Access</field>
        <field name="model_id" ref="model_subscription_contract"/>
        <field name="domain_force">[
            '|',
            ('user_id', '=', user.id),
            ('company_id', 'in', company_ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_subscription_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Managers see all contracts in their allowed companies -->
    <record id="subscription_contract_manager_rule" model="ir.rule">
        <field name="name">Subscription Contract: Manager Access</field>
        <field name="model_id" ref="model_subscription_contract"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_subscription_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============================================================
         Record Rules — Portal Users
         Portal users can ONLY see contracts for their own
         commercial entity (parent company). This is the key
         security boundary for the B2B portal.
    ============================================================ -->
    <record id="subscription_contract_portal_rule" model="ir.rule">
        <field name="name">Subscription Contract: Portal Access (own company only)</field>
        <field name="model_id" ref="model_subscription_contract"/>
        <field name="domain_force">[
            ('commercial_partner_id', 'child_of', user.partner_id.commercial_partner_id.id),
            ('state', 'not in', ['cancelled'])
        ]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal users can read their own subscription plans (for display) -->
    <record id="subscription_plan_portal_rule" model="ir.rule">
        <field name="name">Subscription Plan: Portal Read-Only</field>
        <field name="model_id" ref="model_subscription_plan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
