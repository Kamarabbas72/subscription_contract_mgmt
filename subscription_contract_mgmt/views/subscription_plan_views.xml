<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_plan_list" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <tree string="Subscription Plans" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="price_monthly"/>
                <field name="price_annual"/>
                <field name="billing_cycle"/>
                <field name="trial_days"/>
                <field name="max_users"/>
                <field name="contract_count" string="Active Contracts"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>
    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Plan Name"/></h1>
                        <h3><field name="code" placeholder="e.g. PRO_MONTHLY"/></h3>
                    </div>
                    <group>
                        <group string="Pricing">
                            <field name="price_monthly"/>
                            <field name="price_annual"/>
                            <field name="currency_id"/>
                            <field name="billing_cycle"/>
                        </group>
                        <group string="Trial and Grace">
                            <field name="trial_days"/>
                            <field name="grace_period_days"/>
                            <field name="product_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Limits">
                        <group>
                            <field name="max_users"/>
                            <field name="max_storage_gb"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Features">
                            <field name="feature_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_active": 1}</field>
    </record>
</odoo>